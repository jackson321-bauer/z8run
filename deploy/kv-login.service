[Unit]
Description=KronVault Login API (UDS/udsv3)
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/kv-login/internal.env
ExecStart=/data/kronvault/kv-login/target/release/kv-login --s3-config /etc/kv-login/b2b-s3.json --salt kreuz-salt-33 --space-addr tahdveegeonshln4ye3fvoy3xjsgypz2 --uds /data/z8run/kv-login.sock
ExecStartPost=/bin/sh -c 'sleep 1; chgrp z8run /data/z8run/kv-login.sock && chmod 660 /data/z8run/kv-login.sock'
Restart=always
RestartSec=2
LimitMEMLOCK=infinity
Environment=RUST_LOG=info
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/kronvault/kv-login /data/z8run

[Install]
WantedBy=multi-user.target
